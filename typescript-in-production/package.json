{
  "name": "typescript-in-production-examples",
  "version": "0.1.0",
  "description": "Runnable code examples for the book TypeScript in Production.",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^25.0.0",
    "eslint": "^10.2.1",
    "expect-type": "^1.1.0",
    "prettier": "^3.4.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
